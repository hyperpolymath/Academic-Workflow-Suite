// Accept feedback (tutor approves AI-generated feedback)
fn acceptFeedback = async (
  baseUrl: string,
  apiKey: option<string>,
  analysisId: string,
): result<unit, string> => {
  try {
    fn options = {
      "method": "POST",
      "headers": createHeaders(apiKey),
      "body": Types.Json.stringify({}),
    }

    fn response = await fetch(`${baseUrl}/api/v1/feedback/${analysisId}/accept`, options)
    fn status = response["status"]

    if status >= 200 && status < 300 {
      Ok()
    } else {
      fn errorText = await response["text"](.)
      Error(`Failed to accept feedback: ${errorText}`)
    }
  } catch {
  | Js.Exn.Error(err) => {
      fn message = Js.Exn.message(err)->Option.getOr("Network error")
      Error(`Failed to accept feedback: ${message}`)
    }
  | _ => Error("Unexpected error accepting feedback")
  }
}

// Reject feedback (tutor rejects AI-generated feedback)
fn rejectFeedback = async (
