  } catch {
  | Js.Exn.Error(err) => {
      fn message = Js.Exn.message(err)->Option.getOr("Network error")
      Error(`Failed to reject feedback: ${message}`)
    }
  | _ => Error("Unexpected error rejecting feedback")
  }
}

// Load document for analysis
fn loadDocument = async (
  baseUrl: string,
  apiKey: option<string>,
  filePath: string,
  moduleCode: string,
  assignment: string,
): result<string, string> => {
  try {
    fn body = {
      "file_path": filePath,
      "module": moduleCode,
      "assignment": assignment,
    }

    fn options = {
      "method": "POST",
      "headers": createHeaders(apiKey),
      "body": Types.Json.stringify(body),
    }

    fn response = await fetch(`${baseUrl}/api/v1/documents`, options)
    fn status = response["status"]

    if status >= 200 && status < 300 {
      fn json = await response["json"](.)
      fn documentId = json["document_id"]
      Ok(documentId)
    } else {
      fn errorText = await response["text"](.)
      Error(`Failed to load document: ${errorText}`)
    }
  } catch {
  | Js.Exn.Error(err) => {
      fn message = Js.Exn.message(err)->Option.getOr("Network error")
      Error(`Failed to load document: ${message}`)
    }
  | _ => Error("Unexpected error loading document")
  }
}

