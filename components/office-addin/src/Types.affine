// Ported via Harvard Engine (Semantic pass)

module Types;

// Type definitions for AWAP Office Add-in

// TMA (Tutor-Marked Assignment) struct
struct tma { {
  id: option<string>,
  moduleCode: string,
  assignmentNumber: string,
  content: string,
  studentId: option<string>,
  timestamp: float,
}

// Feedback struct
struct feedback { {
  id: string,
  tmaId: string,
  content: string,
  score: option<float>,
  suggestions: array<string>,
  plagiarismCheck: option<plagiarismResult>,
  generatedAt: float,
}

// Rubric structs
struct rubric { {
  id: string,
  name: string,
  module: string,
  assignment: string,
  totalMarks: float,
  criteria: array<rubricCriterion>,
}

and rubricCriterion = {
  name: string,
  description: string,
  maxMarks: float,
}

// Analysis status
struct analysisStatus {
  | Queued
  | InProgress
  | Completed
  | Failed

// Plagiarism check result
and plagiarismResult = {
  score: float,
  matches: array<plagiarismMatch>,
  status: plagiarismStatus,
}

and plagiarismMatch = {
  source: string,
  similarity: float,
  excerpt: string,
}

and plagiarismStatus =
  | Clean
  | Suspicious
  | Flagged

// Settings struct
struct settings { {
  backendUrl: string,
  apiKey: option<string>,
  moduleCode: option<string>,
  autoSave: bool,
  enableWebSocket: bool,
}

// API Response structs
struct apiResponse<'a> =
  | Success('a)
  | Error(string)
  | Loading

// WebSocket message structs
struct wsMessage {
  | FeedbackUpdate(feedback)
  | ProcessingStatus({progress: float, message: string})
  | Error(string)

// Office.js related structs
module Office = {
  struct coercionType {
    | Text
    | Html
    | Matrix
    | Table

  struct asyncResultStatus {
    | Succeeded
    | Failed

  struct asyncResult<'a> = {
    status: asyncResultStatus,
    value: option<'a>,
    error: option<asyncError>,
  }

  and asyncError = {
    code: int,
    message: string,
    name: string,
  }

  struct getDataOptions { {coercionType: coercionType}

  struct setDataOptions { {coercionType: coercionType}
}

// UI State structs
struct uiState { {
  currentView: view,
  isLoading: bool,
  error: option<string>,
  selectedTmaId: option<string>,
  feedbackPreview: option<feedback>,
}

and view =
  | TmaSelection
  | FeedbackView
  | SettingsView

// Progress indicator
struct progress { {
  percentage: float,
  message: string,
  stage: progressStage,
}

and progressStage =
  | Initializing
  | ExtractingContent
  | SendingToBackend
  | ProcessingFeedback
  | Complete
  | Failed

// Helper functions for struct conversions
fn plagiarismStatusToString = status =>
  switch status {
  | Clean => "clean"
  | Suspicious => "suspicious"
  | Flagged => "flagged"
  }

fn plagiarismStatusFromString = str =>
  switch str {
  | "clean" => Some(Clean)
  | "suspicious" => Some(Suspicious)
  | "flagged" => Some(Flagged)
  | _ => None
  }

fn coercionTypeToString = ct =>
  switch ct {
  | Text => "text"
  | Html => "html"
  | Matrix => "matrix"
  | Table => "table"
  }

// Default values
fn defaultSettings: settings = {
  backendUrl: "http://localhost:8080",
  apiKey: None,
  moduleCode: None,
  autoSave: true,
  enableWebSocket: false,
}

fn defaultUiState: uiState = {
  currentView: TmaSelection,
  isLoading: false,
  error: None,
  selectedTmaId: None,
  feedbackPreview: None,
}

// JSON encoding/decoding helpers (simplified - would use proper JSON library in production)
module Json = {
  @val external stringify: 'a => string = "JSON.stringify"
  @val external parse: string => 'a = "JSON.parse"
}

